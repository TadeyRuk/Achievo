# Server-only (never prefix with VITE_)
# Ed25519 key that mints claim vouchers (Stellar secret). Required for /api/reward.
ATTESTOR_SECRET=
# Relayer / fee-paying source account. Prefer omitting on the web/API project when using the remote signer.
ADMIN_SECRET=
# Phase 2 isolated signer (services/signer) — set both to enable remote claim submission
SIGNER_URL=
SIGNER_HMAC_SECRET=
GROQ_API_KEY=
# Optional pepper for opaque identity ids (defaults to IDENTITY_SESSION_SECRET)
IDENTITY_ID_PEPPER=
# Protects /api/reconcile (GitHub Actions schedule / ops). Required in production.
CRON_SECRET=

# SEP-10 Web Auth (required for /api/web-auth and /api/reward)
SEP10_SERVER_SECRET=
SEP10_JWT_SECRET=
HOME_DOMAIN=
WEB_AUTH_DOMAIN=
# Optional absolute URL; defaults to https://$HOME_DOMAIN/api/web-auth
WEB_AUTH_ENDPOINT=
# Optional public key override for stellar.toml SIGNING_KEY
SEP10_SIGNING_KEY=

# Network: testnet (default) | public
STELLAR_NETWORK=testnet
VITE_STELLAR_NETWORK=testnet
# Optional passphrase override
NETWORK_PASSPHRASE=
VITE_NETWORK_PASSPHRASE=

# Optional network overrides (defaults = Stellar testnet)
CONTRACT_ID=
SOROBAN_RPC_URL=
HORIZON_URL=
VITE_CONTRACT_ID=
VITE_SOROBAN_RPC_URL=
VITE_HORIZON_URL=

# Identity session HMAC (required for profile sessions)
IDENTITY_SESSION_SECRET=

# Required in production (VERCEL_ENV=production fails closed without these)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Telegram payout feed
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Google Forms feedback (see docs/GOOGLE_FORMS_SETUP.md)
GOOGLE_FORM_ID=
GOOGLE_FORM_ENTRY_TYPE=
GOOGLE_FORM_ENTRY_RATING=
GOOGLE_FORM_ENTRY_COMMENT=
GOOGLE_FORM_ENTRY_NAME=
GOOGLE_FORM_ENTRY_WALLET=
GOOGLE_FORM_ENTRY_REWARD=
GOOGLE_FORM_ENTRY_ACTIVITY=
GOOGLE_FORM_ENTRY_TXHASH=

# Client analytics (optional — omit to disable PostHog)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com
